# Másold ezt a fájlt .env.local néven, és töltsd ki a valós értékekkel.
# A .env.local SOHA nem kerül git-be (lásd .gitignore) — ide biztonságos titkot tenni.

# Resend API kulcs (resend.com -> API Keys)
RESEND_API_KEY=

# Feladó cím. Amíg nincs Resendnél hitelesített saját domain, hagyd ezt üresen —
# ilyenkor a kód automatikusan a teszt-feladót ("onboarding@resend.dev") használja,
# ami viszont csak a Resend-fiókodhoz tartozó e-mail címre tud kézbesíteni.
# Ha van hitelesített domain (pl. cattnrfehervar.hu), állítsd be így:
# RESEND_FROM_EMAIL="Cat TNR Fehérvár <ertesites@cattnrfehervar.hu>"
RESEND_FROM_EMAIL=

# Ide érkezzenek az űrlap-értesítések. Ha üresen hagyod, a src/data/site.ts-ben
# megadott siteConfig.email-t használja a kód.
RESEND_TO_EMAIL=

# --- Supabase (admin felület + cica/történet adatok) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TITKOS — csak szerveroldalon használt, sose kerül a böngészőbe. Ne oszd meg senkivel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin bejelentkezés ---
# Ezt a jelszót kell majd megadni a /admin oldalon a belépéshez.
ADMIN_PASSWORD=
